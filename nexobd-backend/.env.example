NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://nexobd:change_me@localhost:5432/nexobd?schema=public
DB_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=nexobd-api
JWT_AUDIENCE=nexobd-frontend
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# false: refreshToken in JSON (Postman/native clients). true: HttpOnly cookie.
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct local access.
# Do not trust every proxy. Restrict origin network access in production.
TRUST_PROXY=
LOG_LEVEL=info
API_DOCS_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Placeholder only. Set real credentials in .env or the hosting secret manager.
